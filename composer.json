{
    "name": "linkrobins/flarum-chirp",
    "description": "Chirp — live audio rooms for Flarum. Attach a live audio stage to any discussion: unlimited listeners, speakers on stage, and the thread is the chat.",
    "keywords": [
        "voice",
        "flarum",
        "audio",
        "voice",
        "live",
        "chirp"
    ],
    "type": "flarum-extension",
    "license": "MIT",
    "authors": [
        {
            "name": "Karl Bullock",
            "email": "karl@linkrobins.com"
        }
    ],
    "homepage": "https://linkrobins.com/chirp",
    "support": {
        "issues": "https://github.com/linkrobins/chirp/issues",
        "source": "https://github.com/linkrobins/chirp",
        "docs": "https://linkrobins.com/chirp",
        "forum": "https://linkrobins.com/forum",
        "email": "karl@linkrobins.com"
    },
    "require": {
        "flarum/core": "^2.0",
        "guzzlehttp/guzzle": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "LinkRobins\\Chirp\\": "src/"
        }
    },
    "minimum-stability": "beta",
    "prefer-stable": true,
    "extra": {
        "flarum-extension": {
            "title": "Link Robins Chirp",
            "icon": {
                "name": "fas fa-microphone",
                "color": "#07adcc",
                "backgroundColor": "#1a2535"
            }
        },
        "flarum-cli": {
            "modules": {
                "githubActions": true,
                "backendTesting": true
            }
        }
    },
    "require-dev": {
        "flarum/testing": "^2.0",
        "flarum/phpstan": "^2.0",
        "flarum/subscriptions": "^2.0@RC"
    },
    "autoload-dev": {
        "psr-4": {
            "LinkRobins\\Chirp\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "analyse:phpstan": "phpstan analyse",
        "clear-cache:phpstan": "phpstan clear-result-cache",
        "test": [
            "@test:unit",
            "@test:integration"
        ],
        "test:unit": "phpunit -c tests/phpunit.unit.xml",
        "test:integration": "phpunit -c tests/phpunit.integration.xml",
        "test:setup": "@php tests/integration/setup.php"
    }
}
